ENV=development

# SQLite by default. For Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nyayvault
DATABASE_URL=sqlite:///./nyayvault.db

# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-this-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=250

# Comma-separated. Use "*" only for local/demo use.
CORS_ORIGINS=*
